---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { articles } from '../../lib/content.ts';

export function getStaticPaths() {
  const tags = [...new Set(articles().flatMap((a) => a.tags))];
  return tags.map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag as string;
const items = articles()
  .filter((a) => a.tags.includes(tag))
  .sort((a, b) => b.importance - a.importance);
---

<Base title={`#${tag}`} description={`标签「${tag}」相关的科技、金融、AI 资讯，共 ${items.length} 条。`}>
  <section class="border-b border-[var(--line)] pb-7">
    <div class="eyebrow">TAG</div>
    <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">#{tag}</h1>
    <p class="mt-3 text-sm text-[var(--muted)]">共 {items.length} 条相关资讯</p>
  </section>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {items.map((article) => <StoryCard article={article} />)}
  </div>
</Base>
