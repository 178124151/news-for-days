---
import type { Article } from '../lib/schema.ts';
import { CATEGORY_LABEL } from '../lib/schema.ts';
import { CAT_STYLE } from '../lib/ui.ts';
import { articleHref, formatDateTime } from '../lib/content.ts';

interface Props {
  article: Article;
  feature?: boolean;
}
const { article, feature = false } = Astro.props;
const cat = CAT_STYLE[article.category];
const covered = article.alsoCoveredBy?.length ?? 0;
---

<a
  href={articleHref(article)}
  class:list={[
    'card card-hover group block h-full',
    feature ? 'p-6 sm:p-8' : 'p-5',
  ]}
>
  <div class="flex flex-wrap items-center gap-2">
    <span class:list={['inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium', cat.chip]}>
      {CATEGORY_LABEL[article.category]}
    </span>
    {covered > 0 && <span class="chip">另有 {covered} 家报道</span>}
    <span class="ml-auto text-[11px] text-[var(--faint)]">{formatDateTime(article.publishedAt)}</span>
  </div>

  <h3
    class:list={[
      'mt-3 font-semibold tracking-tight leading-snug group-hover:text-[var(--accent)] transition-colors',
      feature ? 'text-2xl sm:text-[28px] leading-[1.35]' : 'text-[17px] sm:text-[18px]',
    ]}
  >
    {article.titleZh}
  </h3>

  <p
    class:list={[
      'mt-2 text-[var(--muted)] prose-zh',
      feature ? 'text-[15px] clamp-3' : 'text-[13.5px] clamp-2',
    ]}
  >
    {article.summary}
  </p>

  <div class="mt-4 flex items-center gap-1.5 text-[11.5px] text-[var(--faint)]">
    <span class="font-medium text-[var(--muted)]">{article.sourceName}</span>
    <span class="dot"></span>
    <span>{article.readMinutes} 分钟阅读</span>
    {feature && (
      <>
        <span class="dot"></span>
        <span>{article.aiProvider === 'translate' ? '机翻' : article.aiProvider === 'extractive' ? '原文摘录' : 'AI 摘要'}</span>
      </>
    )}
  </div>
</a>
