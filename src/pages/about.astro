---
import Base from '../layouts/Base.astro';
import { href, latestHealth, sources } from '../lib/content.ts';

const health = latestHealth();
const sourceList = sources();
---

<Base title="关于本站" description="Signal Daily 是一个个人使用的科技、金融、AI 每日资讯站，全自动聚合公开来源，零成本运行。">
  <article class="mx-auto max-w-3xl">
    <div class="eyebrow">ABOUT</div>
    <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">关于 Signal Daily</h1>

    <div class="mt-6 space-y-5 text-[15px] leading-8 prose-zh text-[var(--muted)]">
      <p>
        Signal Daily（信号日报）是一个<strong class="text-[var(--ink)]">个人使用</strong>的科技、金融、AI 每日资讯站。目标只有一个：每天早上花 5–10 分钟，读完真正值得知道的 20–30 件事。
      </p>
      <p>
        内容来自 {sourceList.length} 个公开 RSS / Atom 源与官方 API。每天定时抓取后，系统会做 URL 与标题去重、同事件聚类，再用免费 AI 或机翻生成中文标题与 80–200 字摘要，最后构建成静态页面并自动发布。
      </p>
      <p>
        没有人工编辑，没有账号、评论与推荐算法，也不接广告或做商业化。摘要均由程序生成，页面已明确标注；发现错误请以原文为准。
      </p>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      <div class="card p-4">
        <div class="text-2xl font-semibold tabular-nums">{sourceList.length}</div>
        <div class="mt-1 text-xs text-[var(--faint)]">公开内容源</div>
      </div>
      <div class="card p-4">
        <div class="text-2xl font-semibold tabular-nums">{health?.published ?? 0}</div>
        <div class="mt-1 text-xs text-[var(--faint)]">最近一期条目</div>
      </div>
      <div class="card p-4">
        <div class="text-2xl font-semibold tabular-nums">$0</div>
        <div class="mt-1 text-xs text-[var(--faint)]">月度运行成本</div>
      </div>
    </div>

    <h2 class="mt-10 text-lg font-semibold">技术栈</h2>
    <ul class="mt-3 space-y-2 text-sm text-[var(--muted)]">
      <li>· Astro 5 + Tailwind CSS 4 构建静态站点，Pagefind 提供站内搜索</li>
      <li>· TypeScript 管线：采集 → 规范化 → 去重聚类 → AI 加工 → 自动质检 → 日报</li>
      <li>· 内容以 JSON 存在仓库中（仓库即数据库），GitHub Actions 每日定时运行</li>
      <li>· 托管于 GitHub Pages，无数据库、无常驻服务</li>
    </ul>

    <h2 class="mt-8 text-lg font-semibold">访问与合规</h2>
    <p class="mt-3 text-sm leading-7 text-[var(--muted)]">
      本站部署在 GitHub Pages，中国大陆访问可能不稳定，可用代理或 RSS 阅读器。内容仅做聚合与摘要，不转载全文、不镜像图片；如权利方认为内容不当，可通过
      <a class="text-[var(--accent)] hover:underline" href="https://github.com/178124151/news-for-days/issues">GitHub Issue</a>
      提交下架请求。
    </p>

    <p class="mt-8 flex flex-wrap gap-4 text-sm">
      <a class="text-[var(--accent)] hover:underline" href={href('disclaimer/')}>免责声明 →</a>
      <a class="text-[var(--accent)] hover:underline" href={href('privacy/')}>隐私说明 →</a>
      <a class="text-[var(--accent)] hover:underline" href={href('sources/')}>内容来源 →</a>
    </p>
  </article>
</Base>
