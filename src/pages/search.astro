---
import Base from '../layouts/Base.astro';
import { href, tagsOf, articles } from '../lib/content.ts';

const tags = tagsOf(articles()).slice(0, 10);
---

<Base title="站内搜索" description="搜索 Signal Daily 收录的科技、金融、AI 资讯。">
  <section class="mx-auto max-w-3xl">
    <div class="eyebrow">SEARCH</div>
    <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">站内搜索</h1>
    <p class="mt-3 text-sm text-[var(--muted)]">纯静态索引（Pagefind），在浏览器本地检索，无需服务端。</p>

    <link rel="stylesheet" href={href('pagefind/pagefind-ui.css')} />
    <div id="search" class="mt-6"></div>

    <div class="mt-8">
      <div class="eyebrow mb-3">热门标签</div>
      <div class="flex flex-wrap gap-2">
        {tags.map(({ tag, count }) => (
          <a href={href(`tags/${encodeURIComponent(tag)}/`)} class="chip">#{tag} <span class="text-[var(--faint)]">{count}</span></a>
        ))}
      </div>
    </div>
  </section>

  <script src={href('pagefind/pagefind-ui.js')} is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (!window.PagefindUI) return;
      new window.PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: '搜索 OpenAI、美联储、芯片…',
          zero_results: '没有找到「[SEARCH_TERM]」相关结果',
          many_results: '找到 [COUNT] 条结果',
          one_result: '找到 1 条结果',
          searching: '搜索中…',
        },
      });
    });
  </script>
</Base>
